DirectoryIndex index.php
RewriteEngine On
RewriteBase /

# 1. FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. LANGUAGE URL ROUTING
# Skip if requesting actual files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Handle language-specific URLs: /fr/, /ar/, /en/, etc.
# Capture 2-3 letter language codes
RewriteRule ^(en|zh|hi|es|ar|fr|bn|pt|ru|id|ur|de|ja|pcm|ha|tr|pnb|sw|tl|fa|ko|th|jv|it|vi|nl|pl|uk|ca|ga|sv|da|no|ro|el|cs|fi|hu)/?$ index.php?lang=$1 [L,QSA]
RewriteRule ^(en|zh|hi|es|ar|fr|bn|pt|ru|id|ur|de|ja|pcm|ha|tr|pnb|sw|tl|fa|ko|th|jv|it|vi|nl|pl|uk|ca|ga|sv|da|no|ro|el|cs|fi|hu)/(.+)$ $2?lang=$1 [L,QSA]

# 3. PASSWORD GATE ENABLED
DirectoryIndex index.php
