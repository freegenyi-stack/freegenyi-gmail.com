RewriteEngine On

# 1. FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. THE "ELITE" BYPASS (Stop redirection for these specific files)
RewriteCond %{REQUEST_URI} ^/login\.html [NC,OR]
RewriteCond %{REQUEST_URI} ^/parent_dashboard\.html [NC,OR]
RewriteCond %{REQUEST_URI} ^/school_dashboard\.html [NC,OR]
RewriteCond %{REQUEST_URI} ^/institution_dashboard\.html [NC,OR]
RewriteCond %{REQUEST_URI} ^/under_construction\.html [NC,OR]
RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
RewriteCond %{REQUEST_URI} ^/assets/ [NC]
RewriteRule ^ - [L]

# 3. REDIRECT EVERYTHING ELSE TO MAINTENANCE
RewriteRule !^under_construction\.html$ /under_construction.html [L,R=302]
