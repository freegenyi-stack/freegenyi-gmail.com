RewriteEngine On

# 1. Forcer le HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Mode MAINTENANCE (Masquer le site au public)
# On n'applique pas la redirection pour les pages essentielles au test :
RewriteCond %{REQUEST_URI} !/under_construction.html$ [NC]
RewriteCond %{REQUEST_URI} !/login.html$ [NC]
RewriteCond %{REQUEST_URI} !/parent_dashboard.html$ [NC]
RewriteCond %{REQUEST_URI} !/school_dashboard.html$ [NC]
RewriteCond %{REQUEST_URI} !/institution_dashboard.html$ [NC]

# On laisse passer les assets et les APIs
RewriteCond %{REQUEST_URI} !/assets/ [NC]
RewriteCond %{REQUEST_URI} !/api/ [NC]

# --- OPTIONNEL : VOTRE IP (Moyen le plus sûr) ---
# Si vous me donnez votre IP, on peut tout débloquer juste pour vous.
# RewriteCond %{REMOTE_ADDR} !=XXX.XXX.XXX.XXX

# Rediriger tout le reste vers la page de construction
RewriteRule ^(.*)$ /under_construction.html [L,R=302]
