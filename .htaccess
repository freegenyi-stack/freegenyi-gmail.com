RewriteEngine On

# 1. FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. FULL MAINTENANCE LOCK (User request)
# 2. FULL MAINTENANCE LOCK except whitelist
# Do nothing for whitelisted files/folders
RewriteRule ^(under_construction\.html|assets/|api/|login\.html|parent_dashboard\.html|school_dashboard\.html|institution_dashboard\.html) - [L]

# Redirect everything else
RewriteCond %{REQUEST_URI} !/under_construction.html$ [NC]
RewriteRule ^(.*)$ /under_construction.html [L,R=302]
