RewriteEngine On

# 1. FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. DO NOT REDIRECT THE FOLLOWING PATHS (White List)
RewriteRule ^(under_construction\.html|login\.html|parent_dashboard\.html|school_dashboard\.html|institution_dashboard\.html|assets/|api/) - [L,NC]

# 3. REDIRECT EVERYTHING ELSE TO MAINTENANCE PAGE
RewriteRule !^under_construction\.html$ /under_construction.html [L,R=302]
