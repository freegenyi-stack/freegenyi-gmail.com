RewriteEngine On
RewriteBase /

# 1. Empêcher l'accès direct aux dossiers sensibles
Options -Indexes

# 2. Routage vers les pages spécifiques (Format /DZ-fr/page)
RewriteRule ^([A-Z]{2})-([a-z]{2})/about/?$ about.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/mission/?$ mission.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/approach/?$ approach.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/science/?$ science.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/goals/?$ goals.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/parents/?$ parents.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/schools/?$ schools.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/ngos/?$ ngos.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/shop/?$ shop.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/investors/?$ investors.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/faq/?$ faq.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/blog/?$ blog.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/press/?$ press.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/status/?$ status.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/contact/?$ contact.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/privacy/?$ privacy.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/terms/?$ terms.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/cookies/?$ cookies.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/legal/?$ legal.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/data-protection/?$ data-protection.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/login/?$ auth/login.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/register/?$ auth/register.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/verify-pending/?$ auth/verify-pending.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/forgot-password/?$ auth/forgot-password.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/reset-password/?$ auth/reset-password.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/check-db/?$ auth/check-db.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/dashboard/parent/?$ dashboard/parent.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/dashboard/onboarding/?$ dashboard/onboarding.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/dashboard/profile/?$ dashboard/profile.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/dashboard/children/?$ dashboard/children.php [L,QSA,NC]
RewriteRule ^([A-Z]{2})-([a-z]{2})/dashboard/child/?$ dashboard/child.php [L,QSA,NC]

# Routes Globales (Légal & Support)
RewriteRule ^privacy\.html$ privacy.php [L,QSA]
RewriteRule ^terms\.html$ terms.php [L,QSA]
RewriteRule ^privacy$ privacy.php [L,QSA]
RewriteRule ^terms$ terms.php [L,QSA]
RewriteRule ^faq$ faq.php [L,QSA]
RewriteRule ^contact$ contact.php [L,QSA]

# Sitemap et Robots
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 3. Accueil avec locale
RewriteRule ^([A-Z]{2})-([a-z]{2})/$ index.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})$ $1-$2/ [R=301,L]
