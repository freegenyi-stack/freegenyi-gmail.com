RewriteEngine On
RewriteBase /

# 1. Empêcher l'accès direct aux dossiers sensibles
Options -Indexes

# 2. Routage vers les pages spécifiques (Format /DZ-fr/page)
RewriteRule ^([A-Z]{2})-([a-z]{2})/about$ about.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/goals$ goals.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/parents$ parents.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/schools$ schools.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/ngos$ ngos.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/shop$ shop.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/login$ auth/login.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})/auth/register$ auth/register.php [L,QSA]

# Routes Globales (Légal & Support)
RewriteRule ^privacy$ privacy.php [L,QSA]
RewriteRule ^terms$ terms.php [L,QSA]
RewriteRule ^faq$ faq.php [L,QSA]
RewriteRule ^contact$ contact.php [L,QSA]

# 3. Accueil avec locale
RewriteRule ^([A-Z]{2})-([a-z]{2})/$ index.php [L,QSA]
RewriteRule ^([A-Z]{2})-([a-z]{2})$ $1-$2/ [R=301,L]
