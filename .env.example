# FreeGeny PHP — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs DZHoster

# Application
APP_ENV=production
APP_DEBUG=false

# Base de données MySQL (cPanel → MySQL Databases)
DB_HOST=localhost
DB_NAME=votre_prefix_freegenydb
DB_USER=votre_prefix_freeuser
DB_PASS=votre_mot_de_passe_mysql

# Email (optionnel - pour notifications parents)
MAIL_HOST=mail.freegeny.com
MAIL_USER=noreply@freegeny.com
MAIL_PASS=
MAIL_FROM_NAME=FreeGeny

# Paiements Stripe (Phase 2 - laisser vide pour l'instant)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
